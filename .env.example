# =================================================================
# AILMS Environment Variables Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. Database Configuration (MySQL)
# -----------------------------------------------------------------
# Mật khẩu root của MySQL Server
MYSQL_ROOT_PASSWORD=123456
# Tên cơ sở dữ liệu mặc định của hệ thống
MYSQL_DATABASE=ailms
# Tài khoản user kết nối database cho ứng dụng
MYSQL_USER=ailms_user
# Mật khẩu của user kết nối database
MYSQL_PASSWORD=ailms_pass

# -----------------------------------------------------------------
# 2. Spring Boot Profile Configuration
# -----------------------------------------------------------------
# Profile hoạt động của Spring Boot ('dev' để chạy thường, 'seed' hoặc 'dev,seed' để tự động nạp dữ liệu mẫu)
SPRING_PROFILES_ACTIVE=seed

# -----------------------------------------------------------------
# 3. Storage Configuration (MinIO - Lưu trữ file/object)
# -----------------------------------------------------------------
# Username quản trị MinIO
MINIO_ROOT_USER=minioadmin
# Password quản trị MinIO
MINIO_ROOT_PASSWORD=minioadmin123
# Endpoint công khai của MinIO dùng để sinh URL xem/tải file cho người dùng (ví dụ domain Tailscale hoặc domain public)
MINIO_EXTERNAL_ENDPOINT=https://datdepzaivcl.taile009f4.ts.net

# -----------------------------------------------------------------
# 4. AI Service Configuration
# -----------------------------------------------------------------
# API Key sử dụng dịch vụ Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
# Tên model Gemini mặc định sử dụng (ví dụ: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Token bí mật để xác thực giao tiếp nội bộ giữa Backend Spring Boot và AI Service (Header X-Internal-Token)
AI_INTERNAL_SECRET=dev_internal_secret_123

# -----------------------------------------------------------------
# 5. Email SMTP Configuration (Gửi mail qua Gmail App Password)
# -----------------------------------------------------------------
# Địa chỉ email dùng để gửi thư hệ thống
EMAIL_USERNAME=your_email@gmail.com
# Mật khẩu ứng dụng (App Password) sinh từ tài khoản Google
EMAIL_PASSWORD=your_gmail_app_password

# -----------------------------------------------------------------
# 6. JWT Security Configuration
# -----------------------------------------------------------------
# Chuỗi secret key dùng để ký và giải mã JSON Web Token (JWT) cho xác thực người dùng
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# -----------------------------------------------------------------
# 7. Frontend URLs & Redirects
# -----------------------------------------------------------------
# Danh sách các URL Frontend được phép truy cập API (CORS) phân cách bằng dấu phẩy
FRONTEND_URL=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://213.163.201.42,https://datdepzaivcl.taile009f4.ts.net

# Đường dẫn đến trang đặt mật khẩu trên Frontend, dùng để nhúng vào Email kích hoạt tài khoản / đặt lại mật khẩu gửi cho người dùng
FRONTEND_SET_PASSWORD_URL=http://localhost:5173/set-password

# -----------------------------------------------------------------
# 8. Frontend Environment Configuration
# -----------------------------------------------------------------
# -----------------------------------------------------------------
# 9. PayPal Sandbox Configuration
# -----------------------------------------------------------------
# Copy Client ID và Secret mới sau khi rotate từ PayPal Developer Dashboard Sandbox; không commit secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# PayPal redirect trình duyệt về local frontend, không cần ngrok cho flow capture này.
PAYPAL_RETURN_URL=http://localhost/payment/result
PAYPAL_CANCEL_URL=http://localhost/payment/result?cancelled=1
# Giá gói được lưu VND; Sandbox quy đổi rõ ràng sang USD bằng tỷ giá cấu hình này.
PAYPAL_CURRENCY=USD
PAYPAL_VND_PER_UNIT=26000

# URL gốc để Frontend gọi API của Backend
VITE_API_BASE_URL=/api
