# =================================================================
# AI PERSONALIZED LMS - ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Sao chép tệp này thành .env trước khi khởi chạy hệ thống:
# cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. Database Configuration (MySQL 8.4)
# -----------------------------------------------------------------
# Mật khẩu tài khoản root của MySQL Server
MYSQL_ROOT_PASSWORD=123456

# Tên cơ sở dữ liệu chính của hệ thống
MYSQL_DATABASE=ailms

# Tên tài khoản người dùng kết nối database cho ứng dụng
MYSQL_USER=ailms_user

# Mật khẩu kết nối database của tài khoản ứng dụng
MYSQL_PASSWORD=ailms_pass


# -----------------------------------------------------------------
# 2. Spring Boot Profile Configuration
# -----------------------------------------------------------------
# Profile môi trường chạy của Spring Boot
# - 'dev' : Chạy môi trường phát triển thông thường
# - 'seed': Tự động nạp dữ liệu mẫu khởi tạo (User, Role, Course,...)
# - 'prod': Chạy môi trường production
SPRING_PROFILES_ACTIVE=seed


# -----------------------------------------------------------------
# 3. Object Storage Configuration (MinIO S3)
# -----------------------------------------------------------------
# Tên tài khoản quản trị MinIO Object Storage
MINIO_ROOT_USER=minioadmin

# Mật khẩu tài khoản quản trị MinIO Object Storage
MINIO_ROOT_PASSWORD=minioadmin123

# Endpoint công khai của MinIO dùng để cấp phát Presigned URLs cho trình duyệt
# (Ví dụ: http://localhost:9000, domain Tailscale, hoặc IP Public máy chủ)
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000


# -----------------------------------------------------------------
# 4. AI Service & Vector Database (Gemini & Qdrant)
# -----------------------------------------------------------------
# Khóa API xác thực Google Gemini AI (Lấy từ https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Tên mô hình LLM mặc định cho tác vụ sinh văn bản và chat streaming
GEMINI_MODEL=gemini-3.5-flash-lite

# Tên mô hình embedding mặc định dùng để vector hóa tài liệu RAG
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Khóa bí mật dùng để xác thực các lời gọi nội bộ giữa Backend và AI Service
AI_INTERNAL_SECRET=dev_internal_secret_123

# Địa chỉ kết nối đến Qdrant Vector Database
QDRANT_URL=http://qdrant:6333

# Khóa API truy cập Qdrant (để trống nếu chạy cụm local không bật auth)
QDRANT_API_KEY=

# Địa chỉ Backend nội bộ mà AI Service dùng để gọi lại khi thực thi Tool Calling
BACKEND_INTERNAL_BASE_URL=http://backend:8080

# Tự động đồng bộ và nạp vector cho danh mục công khai khi khởi động
PUBLIC_CATALOG_VECTOR_STARTUP_SYNC=true


# -----------------------------------------------------------------
# 5. Search Engine Configuration (Meilisearch v1.15)
# -----------------------------------------------------------------
# Môi trường chạy của Meilisearch ('development' hoặc 'production')
MEILI_ENV=development

# Khóa Master Key dùng để xác thực và cấu hình index trên Meilisearch (tối thiểu 16 ký tự)
MEILISEARCH_API_KEY=meilisearch_master_key_secret_123456


# -----------------------------------------------------------------
# 6. Security & JWT Configuration
# -----------------------------------------------------------------
# Chuỗi khóa bí mật (Secret Key 256-bit) dùng để ký và xác thực JSON Web Token (JWT)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970


# -----------------------------------------------------------------
# 7. Email SMTP Service (Google Gmail App Password)
# -----------------------------------------------------------------
# Địa chỉ Gmail hệ thống dùng để gửi email xác thực OTP và thông báo
EMAIL_USERNAME=your_email@gmail.com

# Mật khẩu ứng dụng (App Password 16 ký tự) tạo từ Google Account Security
EMAIL_PASSWORD=your_gmail_app_password


# -----------------------------------------------------------------
# 8. Payment Gateway Configuration (PayPal Sandbox)
# -----------------------------------------------------------------
# Client ID ứng dụng Sandbox từ PayPal Developer Dashboard
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Client Secret ứng dụng Sandbox từ PayPal Developer Dashboard
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# URL gốc của PayPal API Sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# URL chuyển hướng Frontend sau khi người dùng đồng ý thanh toán
PAYPAL_RETURN_URL=http://localhost/payment/result

# URL chuyển hướng Frontend khi người dùng hủy bỏ giao dịch thanh toán
PAYPAL_CANCEL_URL=http://localhost/payment/result?cancelled=1

# Đơn vị tiền tệ thanh toán qua PayPal
PAYPAL_CURRENCY=USD

# Tỷ giá quy đổi cố định từ VND sang USD phục vụ thanh toán Sandbox
PAYPAL_VND_PER_UNIT=26000


# -----------------------------------------------------------------
# 9. Frontend Environment & CORS Configuration
# -----------------------------------------------------------------
# Danh sách các URL nguồn của Frontend được phép gọi API Backend (CORS Whitelist)
FRONTEND_URL=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# Đường dẫn trang đặt mật khẩu mới, dùng để nhúng vào Email kích hoạt/đặt lại mật khẩu
FRONTEND_SET_PASSWORD_URL=http://localhost:5173/set-password

# Đường dẫn base API phía Frontend dùng để gọi Backend REST API
VITE_API_BASE_URL=/api
VITE_BE_URL=/api
