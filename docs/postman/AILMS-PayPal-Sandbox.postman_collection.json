{
  "info": {
    "_postman_id": "4fcef96c-7f20-4b21-8b10-d4f814daa5b2",
    "name": "AILMS - PayPal Sandbox Checkout",
    "description": "Manual test collection for AILMS direct package checkout through PayPal Sandbox. Import the paired environment, then run requests in numeric order. No PayPal secret is stored here.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login as student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{studentUsernameOrEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": "{{authBaseUrl}}/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Login returns access token', function () { pm.expect(body.data.accessToken).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('accessToken', body.data.accessToken);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "2. Inspect course before checkout",
      "item": [
        {
          "name": "2.1 Get course detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{apiBaseUrl}}/v1/courses/{{courseId}}/detail"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Course detail returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Course has active packages', function () { pm.expect(body.data.packages).to.be.an('array').and.not.empty; });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "2.2 Get curriculum and preview access",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{apiBaseUrl}}/v1/courses/{{courseId}}/curriculum"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Curriculum returns HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "3. Create PayPal checkout",
      "item": [
        {
          "name": "3.1 Checkout a SELF_STUDY package",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coursePackageId\": \"{{selfStudyPackageId}}\"\n}"
            },
            "url": "{{apiBaseUrl}}/v1/orders/checkout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Checkout returns HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Checkout returns PayPal approval URL', function () { pm.expect(body.data.payUrl).to.include('paypal.com'); });",
                  "pm.environment.set('orderId', String(body.data.orderId));",
                  "pm.environment.set('paymentTransactionId', String(body.data.paymentTransactionId));",
                  "pm.environment.set('paypalApprovalUrl', body.data.payUrl);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "3.2 Verify order is PENDING",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{apiBaseUrl}}/v1/orders/{{orderId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order is pending before PayPal approval', function () { pm.expect(pm.response.json().data.orderStatus).to.eql('PENDING'); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "4. Approve payment in PayPal Sandbox browser",
      "item": [
        {
          "name": "4.1 Open approval URL manually (instruction)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paypalApprovalUrl}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.execution.skipRequest();",
                  "console.warn('Copy paypalApprovalUrl from the active environment and open it in a browser. Sign in with the Personal Sandbox account, then approve payment.');"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "5. Capture and verify entitlement",
      "item": [
        {
          "name": "5.1 Capture approved PayPal order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{apiBaseUrl}}/v1/payments/paypal/capture?orderId={{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Capture returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Order becomes PAID', function () { pm.expect(pm.response.json().data.orderStatus).to.eql('PAID'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "5.2 Verify order status after capture",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{apiBaseUrl}}/v1/orders/{{orderId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status remains PAID', function () { pm.expect(pm.response.json().data.orderStatus).to.eql('PAID'); });",
                  "pm.test('Payment is SUCCESS', function () { pm.expect(pm.response.json().data.paymentStatus).to.eql('SUCCESS'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "5.3 Repeat capture is idempotent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{apiBaseUrl}}/v1/payments/paypal/capture?orderId={{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Repeated capture stays successful', function () { pm.response.to.have.status(200); });",
                  "pm.test('Repeated capture does not change PAID status', function () { pm.expect(pm.response.json().data.orderStatus).to.eql('PAID'); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
